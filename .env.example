APP_PORT=3000
NUXT_PUBLIC_API_MOCKS=false
NUXT_API_PROXY_TARGET=http://localhost:8080
# Inside Docker the proxy target comes from COMPOSE_API_PROXY_TARGET; NUXT_API_PROXY_TARGET above is for `bun run dev`.
# COMPOSE_API_PROXY_TARGET=http://host.docker.internal:8080
NUXT_PUBLIC_I18N_BASE_URL=http://localhost:3000
API_SCHEMA_URL=http://localhost:8080/openapi/v1.json
