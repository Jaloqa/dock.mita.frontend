    "@tanstack/vue-query": "^5.104.3",
    "@tanstack/vue-table": "^9.3.1",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "chart.js": "4.5.1",
    "nuxt": "^4.6.1",
    "primeicons": "^7",
    "primevue": "^4.5.5",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
