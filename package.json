{
  "name": "dock-mita-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "api:generate": "openapi-typescript ${API_SCHEMA_URL:-http://localhost:8080/openapi/v1.json} -o app/shared/api/schema.d.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.143",
    "@nuxt/ui": "^4.11.3",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.2",
    "nuxt": "^4.6.1",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.3",
    "@playwright/test": "^1.64.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@12.11.2"
}
