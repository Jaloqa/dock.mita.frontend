{
  "name": "dock-mita-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "nuxt typecheck",
    "test": "bun test tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:hybrid": "playwright test --config playwright.hybrid.config.ts",
    "api:generate": "openapi-typescript ${API_SCHEMA_URL:-http://localhost:8080/openapi/v1.json} -o app/shared/api/schema.d.ts"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.6.0",
    "@primeuix/themes": "^2.0.3",
    "@primevue/nuxt-module": "^4.5.5",
